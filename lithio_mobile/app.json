{
  "expo": {
    "name": "LITHIO",
    "slug": "lithio",
    "description": "Linked Intelligent Transport for Higher Innovative Opportunities (Transporte Inteligente Vinculado para Oportunidades Innovadoras).",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.lithio.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#10191C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "LITHIO usa tus fotos para tu foto de perfil.",
          "cameraPermission": "LITHIO usa la cámara para tomar tu foto de perfil."
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#45D6C5",
          "defaultChannel": "default",
          "icon": "./assets/android-icon-monochrome.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#10191C"
        }
      ]
    ],
    "owner": "kairosks",
    "extra": {
      "eas": {
        "projectId": "f032b841-295c-43f4-849e-9f2a186489db"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f032b841-295c-43f4-849e-9f2a186489db",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
