# Entorno: development (local) o production (nube)
APP_ENV=development

# Base de datos. Sin DATABASE_URL se usa SQLite local (lithio.db).
# En la nube usa PostgreSQL, p. ej. la URL que entrega Railway o Render:
# DATABASE_URL=postgresql://usuario:clave@host:5432/lithio
DATABASE_URL=

# Cifrado en reposo de cédula, teléfono y datos de pago (OBLIGATORIO).
# Genera ambas con:  python -m app.crypto
# Para rotar: pon la clave nueva primero y deja la vieja detrás, separadas por coma.
# Si pierdes estas claves, los datos cifrados no se pueden recuperar.
LITHIO_ENCRYPTION_KEYS=
LITHIO_HASH_KEY=

# WhatsApp Cloud API (Meta)
# Configure these values to send automatic ride alerts to drivers.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=crea_un_token_largo_para_meta
# App Secret de la app de Meta: valida la firma X-Hub-Signature-256 del webhook.
WHATSAPP_APP_SECRET=

# Firebase Authentication
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=C:\secure\path\firebase-service-account.json
# En la nube, en lugar de la ruta, pega el JSON completo en una sola línea:
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
ADMIN_FIREBASE_UIDS=

# Web origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Versión mínima del APK (número de compilación de Android, p. ej. 3) y enlace del APK nuevo.
APP_MIN_BUILD=0
APP_LATEST_BUILD=0
APP_DOWNLOAD_URL=
# Plantilla aprobada en Meta para el aviso al conductor (5 variables: pasajero,
# origen, destino, tarifa, horario). Sin ella solo llega si el conductor escribio en 24 h.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es
